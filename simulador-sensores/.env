# =========================================
# CONFIGURACIÓN SIMULADOR IoT CIMARQ
# =========================================
# IMPORTANTE: Este archivo debe tener la misma configuración que el backend
# para garantizar compatibilidad completa

# =========================================
# CONFIGURACIÓN MONGODB (idéntica al backend)
# =========================================
MONGO_URI=mongodb+srv://cimarq:eGEr87FyYHIadm4p@proyectotitulo.idqwtmo.mongodb.net/
DB_NAME=cimarqdb

# Para desarrollo local:
# MONGO_URI=mongodb://admin:cimarq123@localhost:27017/
# DB_NAME=cimarqdb

# =========================================
# CONFIGURACIÓN MQTT (idéntica al backend)
# =========================================
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Para desarrollo local:
# MQTT_BROKER=localhost
# MQTT_PORT=1883

# =========================================
# TÓPICOS MQTT (exactos del backend)
# =========================================
TEMPERATURA_TOPIC=cimarq/temperatura/update
PH_TOPIC=cimarq/ph/update
OXIGENO_TOPIC=cimarq/oxigeno/update

# =========================================
# CONFIGURACIÓN DEL SIMULADOR
# =========================================
# Intervalo entre mediciones (segundos)
# Valor por defecto: 300 (5 minutos)
SIMULATION_INTERVAL=300

# Número de sensores a simular
# Cada sensor tendrá un ID único: sensor_001, sensor_002, etc.
NUM_SENSORS=3

# =========================================
# CONFIGURACIÓN PYTHON
# =========================================
PYTHONUNBUFFERED=1