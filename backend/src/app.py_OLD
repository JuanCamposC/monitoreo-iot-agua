# Obtener todos los datos
@app.route('/sensores', methods=['GET'])
def get_sensores():
    try:
        temperatura = list(db.temperatura.find())
        ph = list(db.ph.find())
        oxigeno = list(db.oxigeno.find())
        for doc in temperatura:
            doc['_id'] = str(doc['_id'])
        for doc in ph:
            doc['_id'] = str(doc['_id'])
        for doc in oxigeno:
            doc['_id'] = str(doc['_id'])
        return jsonify({"success": True, "data": {"temperatura": temperatura, "ph": ph, "oxigeno": oxigeno}})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)}), 500

if __name__ == '__main__':
    app.run(debug=True)